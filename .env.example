# ============================================
# APIキー・認証情報
# ============================================
# その他の設定はプリセット(assets/presets/*.json)で管理します

# TwitterAPI.io（お題取得用、任意）
# TWITTER_API_IO_KEY=

# Gemini API（画像生成用、任意）
# GEMINI_API_KEY=

# bundle.social（SNS投稿用、任意）
# BUNDLE_SOCIAL_API_KEY=
# BUNDLE_SOCIAL_TEAM_ID=

# ============================================
# 通知設定（任意）
# ============================================
# 成功・エラー時にWebhookを送信
# WEBHOOK_URL=https://example.com/webhook

# ログをJSONL形式で追記保存
# LOG_FILE_PATH=./logs/workflow.jsonl
